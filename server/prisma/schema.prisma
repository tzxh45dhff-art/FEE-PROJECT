generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  /// bcrypt hash — never the plaintext, and never returned by the API
  passwordHash String
  createdAt    DateTime     @default(now())

  ownedRooms   Room[]       @relation("RoomOwner")
  memberships  Membership[]
  queued       QueueItem[]
  queuedTracks TrackItem[]
  playlists    Playlist[]
  likes        LikedTrack[]
  messages     Message[]
}

model Room {
  id        String       @id @default(cuid())
  /// Short, URL-safe handle used in room links
  slug      String       @unique
  name      String
  /// friends | couple | study | family | team — see ROOM_TYPES on the client
  type      String
  createdAt DateTime     @default(now())

  ownerId   String
  owner     User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   Membership[]
  queue     QueueItem[]
  tracks    TrackItem[]
  playlists Playlist[]
  likes     LikedTrack[]
  messages  Message[]

  @@index([ownerId])
}

/// A named running order, kept between sessions.
///
/// Belongs to a room rather than to the person who made it — the room is the
/// unit everything else here is scoped to, and a playlist only one member
/// could see would be a private feature inside a shared one. Authorship is
/// recorded because the answer to "who made this" is part of what makes a
/// shared library feel like a place rather than a folder.
model Playlist {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())

  roomId    String
  createdById String
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([roomId, createdAt])
}

/// One song's place in one playlist.
///
/// The song is stored here rather than pointed at, because the things being
/// collected are not rows in this database — they are YouTube ids and uploaded
/// files. A reference table would need somewhere to point.
model PlaylistTrack {
  id         String   @id @default(cuid())
  source     String
  ref        String
  title      String
  artist     String?
  album      String?
  artwork    String?
  duration   Int?
  position   Int
  createdAt  DateTime @default(now())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

/// One person's saved song, inside one room.
///
/// Per person, unlike everything else on this page: what the room is playing
/// is a shared decision, but what you personally keep is not. Scoped to the
/// room as well so a library stays with the people it was built with.
model LikedTrack {
  id        String   @id @default(cuid())
  source    String
  ref       String
  title     String
  artist    String?
  album     String?
  artwork   String?
  duration  Int?
  createdAt DateTime @default(now())

  roomId    String
  userId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One like per song per person — the toggle depends on it.
  @@unique([userId, roomId, source, ref])
  @@index([roomId, userId, createdAt])
}

/// The room's listening queue.
///
/// Its own table rather than a `kind` column on `QueueItem`: a track carries
/// artist and album art that a video has no use for, and the two queues are
/// read on different screens at different times. One table would mean every
/// music query dragging video rows through a filter, and every video row
/// carrying three columns that are always null.
model TrackItem {
  id        String   @id @default(cuid())
  /// file | youtube — see MUSIC_SOURCES on the server
  source    String
  /// A YouTube video id, or a URL to the audio itself.
  ref       String
  title     String
  artist    String?
  album     String?
  /// Cover art. The page's whole palette is derived from this when present.
  artwork   String?
  /// Seconds. Null until something has actually played it.
  duration  Int?
  position  Int
  createdAt DateTime @default(now())

  roomId    String
  addedById String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}

/// Room chat. Persisted, because a conversation people expect to scroll back
/// through is not the same kind of state as "who is online right now".
model Message {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  roomId    String
  authorId  String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

/// The room's watch queue. Persisted, unlike playback position — what you lined
/// up should survive everyone closing the tab; where you were up to should not.
model QueueItem {
  id        String   @id @default(cuid())
  /// youtube | file | external — see WATCH_SOURCES on the client
  source    String
  /// A YouTube video id, a direct media URL, or a free-text title for external.
  ref       String
  title     String
  /// Seconds. Null when unknown, which external titles always are.
  duration  Int?
  thumbnail String?
  /// Sort key within the room. Rewritten on reorder rather than fractionally
  /// interpolated — a queue is short enough that the simpler thing wins.
  position  Int
  createdAt DateTime @default(now())

  roomId    String
  addedById String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}

model Membership {
  id       String   @id @default(cuid())
  role     String   @default("member")
  joinedAt DateTime @default(now())
  /// Touched whenever the member is seen in the room, so the dashboard can
  /// sort by "last active" without a separate events table.
  lastSeen DateTime @default(now())

  userId   String
  roomId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}
