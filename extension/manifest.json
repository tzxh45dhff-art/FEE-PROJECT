{
  "manifest_version": 3,
  "name": "Huddle — Watch Together",
  "version": "0.3.0",
  "description": "Hold a Netflix or Prime Video tab to the same moment as everyone else in your Huddle room.",
  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],
  "background": { "service_worker": "src/worker.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "Huddle" },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["src/bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["src/sync.js", "src/netflix.js", "src/overlay.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.in/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*"
      ],
      "js": ["src/bridge-prime.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.in/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*"
      ],
      "js": ["src/sync.js", "src/prime.js", "src/overlay.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*"
      ],
      "js": ["src/handoff.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
