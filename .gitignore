# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — .env holds the TMDB key. .env.example is the committed template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploaded room videos — user content, not source
server/uploads/

# Local dev database. Committing it ships real accounts and password hashes,
# and gives anyone who clones a private copy that never syncs with yours.
server/prisma/dev.db
server/prisma/*.db-journal




.vercel

# The extension's signing key. Its public half is pinned in manifest.json
# (that is what fixes the extension id); this private half is only needed to
# produce a signed .crx with that same id. Never commit it.
extension/*.pem

# Generated from extension/ by scripts/pack-extension.mjs during the build,
# so the download the app offers can never be a stale committed binary.
public/huddle-extension.zip

# Rendered video is too large for git; the source in intro.html is what's tracked.
marketing/intro-video/*.mp4
marketing/intro-video/stills/

# Linux server kit: downloaded runtimes, logs and database backups.
server/.runtime/
server/logs/
server/backups/
server/prisma/night.db
server/night.db
server/night-uploads/
